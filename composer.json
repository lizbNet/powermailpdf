{
    "name": "undkonsorten/powermailpdf",
    "version": "dev-main",
    "type": "typo3-cms-extension",
    "description": "Powermail PDF Form",
    "homepage": "https://www.undkonsorten.com",
    "authors": [
		{
			"name": "Eike Starkmann",
			"email": "starkmann@undkonsorten.com",
			"homepage": "http://undkonsorten.com",
			"role": "Developer"
		}
    ],
    "license": ["GPL-2.0+"],
    "keywords": ["pdf", "TYPO3", "powermail"],
    "require": {
        "typo3/cms-core": "^12.4 || ^13.4 || ^14.3",
        "tmw/fpdm": "^2.9",
		"in2code/powermail": "^12 || ^13 || ^14.0 || dev-eap",
		"cweagans/composer-patches": "^1.7"
    },
	"extra": {
		"typo3/cms": {
			"extension-key": "powermailpdf"
		},
		"branch-alias":{
			"dev-main": "5.0.x-dev"
		},
		"patches": {
			"tmw/fpdm": {
				"Fix PHP 8.2 dynamic property deprecation (upstream PR codeshell/fpdm#69)": "extensions/powermailpdf/patches/tmw-fpdm-php82-dynamic-property.patch"
			}
		}
	},
    "autoload": {
		"psr-4": {
		 "Undkonsorten\\Powermailpdf\\": "Classes"
		}
  }
}
